// =============================================================================
//  Variable Expense Tracker — Prisma schema
//  PostgreSQL (Supabase). Multi-tenant: every row is scoped by userId.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------
// We mirror Supabase Auth users by their auth.users.id (UUID).
// Created lazily on first authenticated request via /api/me.
// -----------------------------------------------------------------------------
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses        Expense[]
  monthlyBudgets  MonthlyBudget[]
  preferences     UserPreferences?

  @@map("users")
}

// -----------------------------------------------------------------------------
// Per-user UI / behaviour preferences
// -----------------------------------------------------------------------------
model UserPreferences {
  userId           String   @id @db.Uuid
  lastUsedCategory Category @default(SUPERMARKET)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// -----------------------------------------------------------------------------
// Categories — fixed enum, with optional custom name when category = OTHER
// -----------------------------------------------------------------------------
enum Category {
  SUPERMARKET
  GROCERY
  EATING_OUT
  CLOTHING
  VACATIONS
  STOCK_MISC
  OTHER
}

// -----------------------------------------------------------------------------
// Expense — one variable expense entry
// -----------------------------------------------------------------------------
model Expense {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  category       Category
  customCategory String? // populated only when category = OTHER
  note           String?
  spentAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
  @@index([userId, category])
  @@map("expenses")
}

// -----------------------------------------------------------------------------
// MonthlyBudget — one row per user per (year, month)
// -----------------------------------------------------------------------------
model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  year      Int
  month     Int // 1..12
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("monthly_budgets")
}
