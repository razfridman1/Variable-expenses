// =============================================================================
//  Variable Expense Tracker — Prisma schema
//  PostgreSQL (Supabase). Multi-tenant: every row is scoped by userId.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses            Expense[]
  monthlyBudgets      MonthlyBudget[]
  preferences         UserPreferences?
  barMitzvahExpenses  BarMitzvahExpense[]

  @@map("users")
}

model UserPreferences {
  userId           String   @id @db.Uuid
  lastUsedCategory Category @default(SUPERMARKET)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum Category {
  SUPERMARKET
  GROCERY
  EATING_OUT
  CLOTHING
  VACATIONS
  STOCK_MISC
  PAYBOX_TRANSFER
  OTHER
}

model Expense {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  category       Category
  customCategory String?
  note           String?
  spentAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
  @@index([userId, category])
  @@map("expenses")
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("monthly_budgets")
}

enum BarMitzvahCategory {
  HALL
  CATERING
  PHOTOGRAPHY
  MUSIC
  INVITATIONS
  CLOTHING
  GIFTS
  FLOWERS
  DECORATIONS
  TRANSPORTATION
  RABBI
  OTHER
}

model BarMitzvahExpense {
  id              String              @id @default(cuid())
  userId          String              @db.Uuid
  vendor          String
  category        BarMitzvahCategory
  customCategory  String?
  amountPaid      Decimal             @default(0) @db.Decimal(12, 2)
  amountRemaining Decimal             @default(0) @db.Decimal(12, 2)
  paymentDate     DateTime            @default(now())
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paymentDate])
  @@index([userId, category])
  @@map("bar_mitzvah_expenses")
}
